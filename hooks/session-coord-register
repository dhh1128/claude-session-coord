#!/usr/bin/env python3
"""SessionStart hook: register this session in its repo, and say who else is here.

Wired for every SessionStart source (startup, resume, clear, compact) with no matcher, for the
same reason `claude-session-registry` carries none: a resumed session is just as capable of
colliding as a fresh one, and a `/clear` mints a new session id that the board must follow.

Prints nothing when the session is alone in its repo, which is almost every session. That
silence is the contract -- a hook that speaks in the common case gets muted, and then it
protects nobody.

Reads the hook payload on stdin; `TMUX_PANE` comes from the environment, and is the only place
the pane and the session id meet.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

SELF = Path(__file__).resolve()
# Resolve through the symlink chain to the tools checkout that owns this hook.
CLI = SELF.parents[1] / "bin" / "session-coord"
sys.path.insert(0, str(SELF.parents[1]))

from sessioncoord import procio  # noqa: E402  (must follow the path insertion)


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}

    session_id = payload.get("session_id") or ""
    cwd = payload.get("cwd") or os.getcwd()
    transcript = payload.get("transcript_path") or ""
    source = payload.get("source") or ""
    pane = os.environ.get("TMUX_PANE", "")

    # A headless `claude -p` run shares the pane with a real conversation. Registering it would
    # overwrite that pane's record with a throwaway id -- the same trap `claude-session-registry`
    # guards, and it is worth guarding twice rather than discovering once.
    #
    # The `source` strings are checked first because they are cheap, but they are NOT
    # sufficient: a headless run can arrive with an ordinary SessionStart source, which is why
    # `claude-session-registry` inspects the ancestor's argv instead. Do the same here rather
    # than relying on the weaker signal -- flagged in the PR #3 review, by comparison with the
    # hook that already got this right.
    # No pane is no longer a reason to stay out. On a laptop without tmux it is every session,
    # and they are placed by claude pid and start time instead (`liveness.is_live`). What still
    # cannot register is a session we cannot place at all: no pane AND no claude ancestor.
    if not session_id or source in ("print", "background"):
        return 0
    pid = procio.claude_ancestor()
    if pid is not None and procio.is_headless(pid):
        return 0
    if not pane and pid is None:
        return 0

    if not CLI.exists():
        return 0

    argv = [
        str(CLI), "register",
        "--session", session_id,
        "--cwd", cwd,
    ]
    if pane:
        argv += ["--pane", pane]
    if transcript:
        argv += ["--transcript", transcript]
    # The claude process is this hook's own ancestor; walking up to it is cheaper and more
    # reliable than asking tmux, which reports the pane's shell rather than the session.
    if pid:
        argv += ["--pid", str(pid)]

    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return 0
    if out.stdout.strip():
        # Anything printed here lands in the session's context, so it only speaks when there is
        # genuinely a peer or a finding.
        sys.stdout.write(out.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
